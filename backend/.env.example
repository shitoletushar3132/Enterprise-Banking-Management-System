# Application
NODE_ENV=development
APP_NAME=EBMS
APP_PORT=3000
API_PREFIX=api
API_VERSION=v1

# CORS
CORS_ORIGIN=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ebms
MONGODB_DB_NAME=ebms

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# JWT (placeholders for Auth module — do not use in production as-is)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug
