{
  "name": "enterprise-banking-management-system",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Banking Management System monorepo",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run start:dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "start:backend": "npm run start:prod -w backend",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "lint:fix": "npm run lint:fix -w backend && npm run lint:fix -w frontend",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "test": "npm run test -w backend",
    "test:e2e": "npm run test:e2e -w backend",
    "test:cov": "npm run test:cov -w backend",
    "prepare": "husky",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "concurrently": "^9.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "backend/**/*.{ts,js}": [
      "prettier --write",
      "eslint --fix --config backend/eslint.config.mjs"
    ],
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix --config frontend/eslint.config.js"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
